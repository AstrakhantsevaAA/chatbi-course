Table "_dlt_version" [note: 'excluded: dlt internal table'] {
    "version" bigint [not null, note: 'Numeric version of the schema, incremented on each schema change']
    "engine_version" bigint [not null, note: 'Version of the dlt schema engine that created this schema']
    "inserted_at" timestamp [not null, note: 'Timestamp when this schema version was stored']
    "schema_name" text [not null, note: 'Name of the schema']
    "version_hash" text [not null, note: 'Unique hash of the schema content, used to detect changes']
    "schema" text [not null, note: 'JSON representation of the complete schema definition']
    Note {
        'Created by DLT. Tracks schema updates'
    }
}

Table "_dlt_loads" [note: 'excluded: dlt internal table'] {
    "load_id" text [not null, note: 'Unique identifier of the load operation']
    "schema_name" text [note: 'Name of the schema associated with this load']
    "status" bigint [not null, note: 'Status of the load operation (0 = success)']
    "inserted_at" timestamp [not null, note: 'Timestamp when the load was completed']
    "schema_version_hash" text [note: 'Hash of the schema version used during this load']
    Note {
        'Created by DLT. Tracks completed loads'
    }
}

Table "_dlt_pipeline_state" [note: 'excluded: dlt internal table'] {
    "version" bigint [not null, note: 'Numeric version of the pipeline state']
    "engine_version" bigint [not null, note: 'Version of the dlt state engine']
    "pipeline_name" text [not null, note: 'Name of the pipeline this state belongs to']
    "state" text [not null, note: 'Compressed JSON representation of the pipeline state']
    "created_at" timestamp [not null, note: 'Timestamp when this state was created']
    "version_hash" text [note: 'Hash of the state content, used to detect changes']
    "_dlt_load_id" text [not null, note: 'Load identifier linking this row to its load operation']
    "_dlt_id" text [unique, not null]
}

